# Optional — NVIDIA Nemotron "simulation director" (server/director). Put real values in .env.local
# (git-ignored). With no key the bridge runs the deterministic local planner and says so.
NVIDIA_API_KEY=
# OpenAI-compatible endpoint (POST {base}/chat/completions) from build.nvidia.com.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default (used when empty): nvidia/nemotron-3.5-lightning-30b-a3b. Verified live on 2026-11-07:
# tool calling works, and a full director run (12 requests) finishes in about 25 s.
# Other ids checked against integrate.api.nvidia.com on 2026-11-07 (access depends on the key's account):
#   nvidia/nemotron-3-ultra-550b-a55b    tool calling works, but turns often exceed the 15 s timeout
#   nvidia/nemotron-3-super-120b-a12b    listed by GET /models, but returned 404 "Function not found" for our key
#   nvidia/nemotron-3-nano-30b-a3b, nvidia/llama-3.3-nemotron-super-49b-v1.5, nvidia/nvidia-nemotron-nano-9b-v2
#                                        410 Gone (end of life, Aug–Sep 2026)
# Check your own key with GET {base}/models and a one-line chat call before switching.
NEMOTRON_MODEL=
# Per-request timeout. The whole agent loop is capped at NEMOTRON_BUDGET_MS (default 4 × timeout).
NEMOTRON_TIMEOUT_MS=15000
NEMOTRON_BUDGET_MS=
# Reasoning: off (default — faster tool turns; numbers come from the engine anyway) | on | default.
# Nemotron 3 / Nano v2: sent as chat_template_kwargs.enable_thinking (retried without it if the host
# rejects the field). Llama-3.3-Nemotron: "/no_think" or "/think" prefix on the system prompt.
NEMOTRON_THINKING=off
# Self-hosted alternative: deploy a Nemotron NIM on a Brev GPU instance (HackUTD Brev credits) and set
# NVIDIA_BASE_URL=http://<instance>:8000/v1 — the client speaks the same OpenAI-compatible API.

# Optional — tickets the director drafts (open_ticket) are filed as GitHub Issues AFTER a person approves
# them. Use a fine-grained token with Issues: read/write on one repo. Unset → recorded locally only.
GITHUB_TOKEN=
TICKET_REPO=owner/repo
