# Optional — NVIDIA Nemotron "simulation director" (server/director). Put real values in .env.local
# (git-ignored). With no key the bridge runs the deterministic local planner and says so.
NVIDIA_API_KEY=
# OpenAI-compatible endpoint (POST {base}/chat/completions) from build.nvidia.com.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default (used when empty): nvidia/nemotron-3-super-120b-a12b — Nemotron 3 Super, function calling
# supported; this exact id is in the hosted curl example on
# https://build.nvidia.com/nvidia/nemotron-3-super-120b-a12b (checked 2026-11-07).
# Alternates (all list function calling; confirm the hosted id with GET {base}/models before use):
#   nvidia/nemotron-3-nano-30b-a3b           faster/cheaper; page slug, hosted snippet leaves the id blank
#                                            https://build.nvidia.com/nvidia/nemotron-3-nano-30b-a3b
#   nvidia/llama-3.3-nemotron-super-49b-v1.5 reasoning toggled by "/no_think" in the system prompt
#                                            https://build.nvidia.com/nvidia/llama-3_3-nemotron-super-49b-v1_5
#   nvidia/nvidia-nemotron-nano-9b-v2        small; id not re-verified for this build
NEMOTRON_MODEL=
# Per-request timeout. The whole agent loop is capped at NEMOTRON_BUDGET_MS (default 4 × timeout).
NEMOTRON_TIMEOUT_MS=15000
NEMOTRON_BUDGET_MS=
# Reasoning: off (default — faster tool turns; numbers come from the engine anyway) | on | default.
# Nemotron 3 / Nano v2: sent as chat_template_kwargs.enable_thinking (retried without it if the host
# rejects the field). Llama-3.3-Nemotron: "/no_think" or "/think" prefix on the system prompt.
NEMOTRON_THINKING=off
