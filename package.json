{
  "name": "lookahead",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c gray,blue \"npm:dev:bridge\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "dev:web": "vite",
    "dev:bridge": "tsx watch server/index.ts",
    "dev:lan": "concurrently -k -n bridge,web \"npm:dev:bridge\" \"vite --host\"",
    "bridge": "tsx server/index.ts",
    "start": "tsx server/index.ts --prod",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/artifact-page.mjs",
    "preview:artifact": "vite preview --mode artifact --port 4174 --strictPort",
    "validate": "tsx scripts/validate/run.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
